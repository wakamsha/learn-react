    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@learn-react/builder": "workspace:1.0.0",
    "@learn-react/linter": "workspace:*",
    "@learn-react/tsconfig": "workspace:1.0.0",
    "@types/node": "24.13.4",
    "@types/qs": "6.15.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "oxlint": "1.82.0",
